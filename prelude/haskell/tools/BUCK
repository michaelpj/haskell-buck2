load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("build_infra")

source_listing()

prelude = native

prelude.python_bootstrap_binary(
    name = "script_template_processor",
    main = "script_template_processor.py",
    visibility = ["PUBLIC"],
)

# The scripts of the per-module compiles (see _compile_per_module in
# prelude/haskell/compile.bzl).
prelude.export_file(
    name = "per_module_compile.sh",
    visibility = ["PUBLIC"],
)

# Type checking target for Python tool scripts
prelude.python_library(
    name = "scripts-typing",
    srcs = [
        "script_template_processor.py",
    ],
    typing = True,
)
