load("//buck2:haskell.bzl", "haskell_binary", "haskell_library")

haskell_library(
    name = "c",
    srcs = {
        "C.Ann": "C/Ann.hs",
        "C.Plain": "C/Plain.hs",
        "C.Splice": "C/Splice.hs",
    },
    packages = ["base", "template-haskell"],
    deps = ["//a:a", "//th:th"],
    th_build_depends = ["//th:th"],
    per_module = True,
    visibility = ["PUBLIC"],
)

# Prints C.Splice's splice, to see that it follows TH.Gen.
haskell_binary(
    name = "show",
    srcs = {"Main": "Show.hs"},
    packages = ["base"],
    deps = [":c"],
    per_module = True,
)
