load("//buck2:haskell.bzl", "haskell_library")

# GHC 9.14 and later: explicit level imports choose each splice module's
# package dbs, whatever th_build_depends says.
haskell_library(
    name = "e",
    srcs = {
        "E.Gen": "E/Gen.hs",
        "E.Lib": "E/Lib.hs",
    },
    packages = ["base", "template-haskell"],
    deps = ["//a:a", "//th:th"],
    th_build_depends = [],
    per_module = True,
    visibility = ["PUBLIC"],
)
