load("//buck2:haskell.bzl", "haskell_library")

# GHC 9.14 and later: `import splice A.Base`, which //rx:rx re-exports from
# //a:a, a dependency of rx's that isn't this target's.
haskell_library(
    name = "elr",
    srcs = {"ER.M": "ER/M.hs"},
    packages = ["base", "template-haskell"],
    deps = ["//rx:rx"],
    per_module = True,
    visibility = ["PUBLIC"],
)
